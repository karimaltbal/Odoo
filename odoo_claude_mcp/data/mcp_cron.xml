<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_mcp_oauth_cleanup" model="ir.cron">
        <field name="name">Claude MCP: Cleanup expired OAuth codes/tokens</field>
        <field name="model_id" ref="model_mcp_oauth_code"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_mcp_log_purge" model="ir.cron">
        <field name="name">Claude MCP: Purge old call logs</field>
        <field name="model_id" ref="model_mcp_tool_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_old_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
        <field name="active" eval="False"/>
    </record>
</odoo>
