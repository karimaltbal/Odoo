<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_historical_session_list" model="ir.ui.view">
        <field name="name">mcp.historical.import.session.list</field>
        <field name="model">mcp.historical.import.session</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="id"/>
                <field name="name"/>
                <field name="import_type"/>
                <field name="state"/>
                <field name="owner_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_mcp_historical_session_form" model="ir.ui.view">
        <field name="name">mcp.historical.import.session.form</field>
        <field name="model">mcp.historical.import.session</field>
        <field name="arch" type="xml">
            <form string="Historical Excel Import" create="1" delete="0" duplicate="0">
                <header>
                    <button name="action_validate" type="object" string="Validate Workbook" class="btn-primary"
                            invisible="state not in ('uploaded', 'validated', 'failed')"
                            groups="odoo_claude_mcp.group_historical_mcp_import"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'validated'"
                            groups="odoo_claude_mcp.group_historical_mcp_approve"/>
                    <field name="state" widget="statusbar" statusbar_visible="uploaded,validated,approved,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="id"/>
                            <field name="import_type" readonly="id"/>
                            <field name="filename" invisible="1"/>
                            <field name="file" filename="filename" readonly="id" required="1"/>
                        </group>
                        <group>
                            <field name="owner_id" readonly="1"/>
                            <field name="company_id" readonly="id" groups="base.group_multi_company"/>
                            <field name="file_hash" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preflight Report">
                            <field name="validation_json" readonly="1" widget="text" nolabel="1"/>
                        </page>
                        <page string="Execution Result">
                            <field name="execution_result" readonly="1" widget="text" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mcp_historical_session" model="ir.actions.act_window">
        <field name="name">Historical Excel Imports</field>
        <field name="res_model">mcp.historical.import.session</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Upload a historical workbook, then provide its session ID to Claude for validation and approved execution.</p></field>
    </record>
    <menuitem id="menu_mcp_historical_root" name="Historical Excel Imports" sequence="95"
              groups="odoo_claude_mcp.group_historical_mcp_import,odoo_claude_mcp.group_historical_mcp_approve"/>
    <menuitem id="menu_mcp_historical_sessions" name="Import Sessions" parent="menu_mcp_historical_root"
              action="action_mcp_historical_session" sequence="10"
              groups="odoo_claude_mcp.group_historical_mcp_import,odoo_claude_mcp.group_historical_mcp_approve"/>
</odoo>
